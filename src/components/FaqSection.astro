---
// src/components/FaqSection.astro
import { SITE_CONFIG } from '../config/site';

const faqs = [
  {
    q: 'O que é o Cine 4K e como funciona?',
    a: 'O Cine 4K é a plataforma mais completa de entretenimento sob demanda e canais ao vivo em ultra definição 4K. Você tem acesso a mais de 100 mil conteúdos entre lançamentos do cinema, séries de todos os streamings, esportes e pay-per-view diretamente na sua Smart TV, TV Box ou celular, sem necessidade de antenas.'
  },
  {
    q: 'Em quais aparelhos posso assistir ao Cine 4K?',
    a: 'Em praticamente qualquer dispositivo moderno: Smart TVs Samsung (Tizen), LG (webOS), Roku TV, TCL, Android TV, Amazon Fire TV Stick, TV Box, Celulares Android, iPhone (iOS), Tablets, Computadores e Notebooks.'
  },
  {
    q: 'Como solicito meu teste grátis?',
    a: 'Basta clicar em qualquer botão "Teste Grátis" ou "Assistir" no catálogo. Você será direcionado ao nosso WhatsApp oficial onde nosso suporte gera sua lista e instruções em menos de 2 minutos para você testar na sua TV.'
  },
  {
    q: 'Quantas telas posso usar ao mesmo tempo?',
    a: 'Nossos planos liberam de 2 até 3 telas simultâneas na mesma residência, permitindo que você assista ao seu futebol na sala enquanto seus familiares assistem a filmes ou desenhos no quarto.'
  },
  {
    q: 'Qual velocidade de internet é recomendada?',
    a: 'Recomendamos uma conexão de internet estável a partir de 15 Mbps para conteúdos em Full HD e 30 Mbps para streaming em 4K nativo a 60 FPS com áudio 5.1.'
  },
  {
    q: 'Quais são as formas de pagamento disponíveis?',
    a: 'Aceitamos Pix com ativação imediata automatizada e Cartão de Crédito. Não cobramos taxa de instalação e você não fica preso a nenhum contrato de fidelidade.'
  }
];
---

<section id="faq" class="py-16 sm:py-20 bg-[#060b18] border-t border-slate-800/80">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/80 border border-cyan-500/40 text-cyan-300 text-xs font-bold uppercase tracking-wider mb-3">
        <span>Tire suas Dúvidas</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
        Perguntas Frequentes
      </h2>
      <p class="text-slate-400 text-sm mt-2">
        Tudo o que você precisa saber sobre o catálogo Cine 4K e sua ativação
      </p>
    </div>

    <!-- Accordion Items -->
    <div class="flex flex-col gap-3">
      {faqs.map((faq, idx) => (
        <details class="group bg-[#080d1a] border border-slate-800 rounded-2xl overflow-hidden transition-all duration-200 open:border-cyan-500/50">
          <summary class="flex items-center justify-between p-4 sm:p-5 cursor-pointer text-sm sm:text-base font-bold text-white group-hover:text-cyan-300 transition-colors list-none select-none">
            <span>{faq.q}</span>
            <span class="w-6 h-6 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 group-hover:bg-cyan-500 group-hover:text-black transition-all flex-shrink-0 ml-3">
              <svg class="w-4 h-4 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M19 9l-7 7-7-7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </summary>
          <div class="px-4 pb-5 sm:px-5 text-xs sm:text-sm text-slate-300 leading-relaxed border-t border-slate-800/50 pt-3">
            {faq.a}
          </div>
        </details>
      ))}
    </div>

    <!-- CTA Suporte WhatsApp -->
    <div class="mt-10 p-6 rounded-3xl bg-gradient-to-r from-cyan-950/40 to-blue-950/40 border border-cyan-500/30 text-center flex flex-col items-center gap-3">
      <h3 class="text-base sm:text-lg font-black text-white">Ainda ficou com alguma dúvida?</h3>
      <p class="text-xs sm:text-sm text-slate-300 max-w-md">
        Nossa equipe de suporte está online agora no WhatsApp pronta para tirar suas dúvidas e configurar o aplicativo no seu aparelho.
      </p>
      <a 
        href={`https://wa.me/${SITE_CONFIG.whatsapp.number}?text=${encodeURIComponent('Olá! Tenho uma dúvida sobre o Cine 4K antes de assinar.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-black text-xs sm:text-sm tracking-wide shadow-lg shadow-cyan-400/20 active:scale-95 transition-all mt-1"
      >
        <span>Falar com Atendente no WhatsApp</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M5 12h14M12 5l7 7-7 7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

  </div>
</section>

