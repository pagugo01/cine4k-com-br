---
// src/components/Footer.astro
import { SITE_CONFIG } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#03060e] border-t border-slate-900 text-slate-400 py-12 sm:py-16 pb-28 sm:pb-16 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col gap-8">
    
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 pb-8 border-b border-slate-900">
      
      <!-- Logo Cine 4K -->
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-cyan-500 to-blue-600 p-0.5 shadow-md shadow-cyan-500/20">
          <div class="w-full h-full bg-[#040711] rounded-[10px] flex items-center justify-center">
            <span class="text-cyan-400 font-black text-xs tracking-tighter">4K</span>
          </div>
        </div>
        <span class="text-lg font-black tracking-tight text-white group-hover:text-cyan-400 transition-colors">
          CINE<span class="text-cyan-400">4K</span>
        </span>
      </a>

      <!-- Links Rápidos -->
      <nav class="flex flex-wrap items-center gap-4 sm:gap-6 text-slate-300 font-medium">
        <a href="#lancamentos" class="hover:text-cyan-400 transition-colors">Lançamentos</a>
        <a href="#filmes" class="hover:text-cyan-400 transition-colors">Filmes</a>
        <a href="#series" class="hover:text-cyan-400 transition-colors">Séries</a>
        <a href="#canais" class="hover:text-cyan-400 transition-colors">Canais</a>
        <a href="#planos" class="hover:text-cyan-400 transition-colors">Planos</a>
        <a href="/politica-privacidade/" class="hover:text-cyan-400 transition-colors">Política de Privacidade</a>
        <a href="/termos-uso/" class="hover:text-cyan-400 transition-colors">Termos de Uso</a>
      </nav>

    </div>

    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left text-slate-400">
      <p>
        © {currentYear} {SITE_CONFIG.name} — O Maior Catálogo de Streaming & TV em 4K Ultra HD. Todos os direitos reservados.
      </p>
      <p class="text-[11px] text-slate-400 max-w-md">
        As marcas, pôsteres e títulos citados são propriedade de suas respectivas emissoras e distribuidoras. Acesso comercial e suporte exclusivo via WhatsApp oficial.
      </p>
    </div>

  </div>
</footer>

