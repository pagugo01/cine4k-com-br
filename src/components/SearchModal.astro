---
// src/components/SearchModal.astro
import { CATALOG_CATEGORIES } from '../data/catalog';

// Extrai todos os itens únicos do catálogo
const allItems = Array.from(
  new Map(
    CATALOG_CATEGORIES.flatMap(cat => cat.items).map(item => [item.id, item])
  ).values()
);
---

<div 
  id="searchModal" 
  class="fixed inset-0 z-50 flex items-start justify-center p-4 sm:p-6 pt-16 sm:pt-20 bg-black/85 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300"
  aria-hidden="true"
  role="dialog"
>
  <div 
    id="searchCard"
    class="relative w-full max-w-2xl bg-[#080d1a] border border-slate-700/80 rounded-3xl shadow-2xl overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col text-slate-100 max-h-[80vh]"
    onclick="event.stopPropagation()"
  >
    <!-- Barra de Busca Superior -->
    <div class="p-4 sm:p-5 border-b border-slate-800 flex items-center gap-3">
      <svg class="w-5 h-5 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8" stroke-width="2" />
        <path d="M21 21l-4.35-4.35" stroke-width="2" stroke-linecap="round" />
      </svg>
      
      <input 
        id="searchInput" 
        type="search" 
        placeholder="Buscar filme, série, anime ou canal..." 
        autocomplete="off"
        class="w-full bg-transparent text-white placeholder-slate-400 text-sm sm:text-base focus:outline-none"
      />

      <button 
        id="closeSearchModalBtn"
        type="button"
        aria-label="Fechar busca"
        class="w-8 h-8 rounded-full bg-slate-800 text-slate-300 flex items-center justify-center hover:bg-slate-700 hover:text-white transition-colors cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M6 18L18 6M6 6l12 12" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>

    <!-- Resultados da Busca -->
    <div id="searchResults" class="p-4 sm:p-5 overflow-y-auto no-scrollbar flex flex-col gap-2.5">
      <p class="text-xs text-slate-400 text-center py-6">
        Digite pelo menos 2 letras para pesquisar no catálogo...
      </p>
    </div>

  </div>
</div>

<script define:vars={{ itemsList: allItems }}>
  window.openSearchModal = function() {
    const modal = document.getElementById('searchModal');
    const card = document.getElementById('searchCard');
    const input = document.getElementById('searchInput');
    if (!modal || !card) return;

    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100', 'pointer-events-auto');
    card.classList.remove('scale-95');
    card.classList.add('scale-100');
    document.body.style.overflow = 'hidden';

    setTimeout(() => {
      if (input) input.focus();
    }, 100);
  };

  window.closeSearchModal = function() {
    const modal = document.getElementById('searchModal');
    const card = document.getElementById('searchCard');
    if (!modal || !card) return;

    modal.classList.remove('opacity-100', 'pointer-events-auto');
    modal.classList.add('opacity-0', 'pointer-events-none');
    card.classList.remove('scale-100');
    card.classList.add('scale-95');
    document.body.style.overflow = '';
  };

  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('searchModal');
    const closeBtn = document.getElementById('closeSearchModalBtn');
    const openBtn = document.getElementById('openSearchBtn');
    const input = document.getElementById('searchInput');
    const resultsContainer = document.getElementById('searchResults');

    if (openBtn) {
      openBtn.addEventListener('click', window.openSearchModal);
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', window.closeSearchModal);
    }

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) window.closeSearchModal();
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') window.closeSearchModal();
    });

    if (input && resultsContainer) {
      input.addEventListener('input', () => {
        const query = input.value.trim().toLowerCase();
        if (query.length < 2) {
          resultsContainer.innerHTML = '<p class="text-xs text-slate-400 text-center py-6">Digite pelo menos 2 letras para pesquisar no catálogo...</p>';
          return;
        }

        const filtered = itemsList.filter(item => 
          item.title.toLowerCase().includes(query) ||
          item.category.toLowerCase().includes(query) ||
          (item.genres && item.genres.some(g => g.toLowerCase().includes(query)))
        );

        if (filtered.length === 0) {
          resultsContainer.innerHTML = `<p class="text-xs text-slate-400 text-center py-6">Nenhum título encontrado para "<strong>${query}</strong>". Solicite este título no nosso WhatsApp!</p>`;
          return;
        }

        resultsContainer.innerHTML = '';
        filtered.forEach(item => {
          const row = document.createElement('div');
          row.className = 'flex items-center gap-3 p-2 rounded-xl hover:bg-slate-800/80 cursor-pointer transition-colors';
          row.innerHTML = `
            <img src="${item.poster}" alt="${item.title}" class="w-12 h-16 rounded-lg object-cover flex-shrink-0 bg-slate-900 border border-slate-700/60" />
            <div class="flex flex-col flex-1 min-w-0">
              <span class="text-sm font-bold text-white truncate">${item.title}</span>
              <span class="text-xs text-slate-400 mt-0.5">${item.category} • ${item.year}</span>
            </div>
            <span class="px-2 py-1 rounded bg-black/50 text-amber-400 text-xs font-bold flex-shrink-0">★ ${item.rating}</span>
          `;
          row.addEventListener('click', () => {
            window.closeSearchModal();
            if (window.openItemModal) {
              window.openItemModal(item);
            }
          });
          resultsContainer.appendChild(row);
        });
      });
    }
  });
</script>
