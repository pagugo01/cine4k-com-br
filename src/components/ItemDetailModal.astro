---
// src/components/ItemDetailModal.astro
import { SITE_CONFIG } from '../config/site';
---

<div 
  id="itemDetailModal" 
  class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black/85 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300"
  aria-hidden="true"
  role="dialog"
>
  <!-- Modal Card Mobile First -->
  <div 
    id="itemDetailCard"
    class="relative w-full max-w-lg max-h-[85vh] overflow-y-auto bg-[#080d1a] border border-slate-700/80 rounded-2xl sm:rounded-3xl shadow-2xl transform scale-95 transition-transform duration-300 text-slate-100 flex flex-col no-scrollbar"
    onclick="event.stopPropagation()"
  >
    <!-- Header com Imagem de Fundo / Trailer -->
    <div class="relative w-full h-44 sm:h-64 bg-slate-900 overflow-hidden flex-shrink-0">
      <img 
        id="modalBackdrop" 
        src="" 
        alt=""
        class="w-full h-full object-cover object-center filter brightness-[0.7]"
      />
      
      <!-- Trailer Container -->
      <div id="trailerContainer" class="absolute inset-0 hidden bg-black">
        <iframe 
          id="trailerIframe" 
          class="w-full h-full border-0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen
        ></iframe>
      </div>

      <div class="absolute inset-0 bg-gradient-to-t from-[#080d1a] via-[#080d1a]/40 to-transparent"></div>

      <!-- Botão Fechar -->
      <button 
        id="closeDetailModalBtn"
        type="button"
        aria-label="Fechar detalhes"
        class="absolute top-3 right-3 z-20 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-black/70 border border-white/20 text-white flex items-center justify-center hover:bg-cyan-500 hover:text-black transition-all cursor-pointer backdrop-blur-sm"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M6 18L18 6M6 6l12 12" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <!-- Badges Superiores -->
      <div class="absolute top-3 left-3 z-10 flex items-center gap-1.5">
        <span class="px-2 py-0.5 rounded-full bg-cyan-500 text-slate-950 text-[10px] sm:text-xs font-black tracking-wider uppercase shadow">
          4K ULTRA HD
        </span>
        <span id="modalRating" class="px-2 py-0.5 rounded-full bg-black/70 border border-white/10 text-amber-400 text-[10px] sm:text-xs font-bold flex items-center gap-0.5 backdrop-blur-sm">
          ★ <span>0.0</span>
        </span>
      </div>
    </div>

    <!-- Conteúdo do Modal -->
    <div class="p-4 sm:p-6 flex flex-col gap-3.5 -mt-8 relative z-10">
      
      <div class="flex items-start gap-3 sm:gap-4">
        <!-- Mini Poster Flutuante -->
        <img 
          id="modalPoster" 
          src="" 
          alt=""
          class="w-16 sm:w-20 aspect-[2/3] rounded-xl object-cover border-2 border-cyan-400/60 shadow-xl flex-shrink-0 bg-slate-900"
        />

        <div class="flex flex-col flex-1 min-w-0">
          <h2 id="modalTitle" class="text-base sm:text-xl font-black text-white tracking-tight leading-tight line-clamp-2">
            Título do Conteúdo
          </h2>
          
          <div class="flex flex-wrap items-center gap-1.5 text-[11px] text-slate-400 mt-1">
            <span id="modalYear" class="text-cyan-400 font-bold">2026</span>
            <span>•</span>
            <span id="modalDuration">4K Ultra HD</span>
            <span>•</span>
            <span id="modalCategory" class="px-1.5 py-0.2 rounded bg-slate-800 text-slate-300 font-medium">Filmes</span>
          </div>

          <!-- Gêneros -->
          <div id="modalGenres" class="flex flex-wrap gap-1 mt-2">
            <!-- Badges injetadas via JS -->
          </div>
        </div>
      </div>

      <!-- Sinopse -->
      <div class="flex flex-col gap-1 pt-2 border-t border-slate-800/80">
        <h3 class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Sinopse</h3>
        <p id="modalOverview" class="text-xs sm:text-sm text-slate-300 leading-relaxed max-h-36 overflow-y-auto no-scrollbar">
          Carregando informações do catálogo...
        </p>
      </div>

      <!-- Botões de Ação -->
      <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
        <!-- Botão Assistir Completo (Abre o Modal de Assinatura) -->
        <button 
          id="modalPlayBtn"
          type="button"
          class="flex-1 py-3 px-5 rounded-2xl bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-black text-xs sm:text-sm tracking-wide flex items-center justify-center gap-2 shadow-lg shadow-cyan-400/20 active:scale-95 transition-all cursor-pointer min-h-[44px]"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <polygon points="5 3 19 12 5 21 5 3" />
          </svg>
          <span>Assistir Completo em 4K</span>
        </button>

        <!-- Botão Trailer -->
        <button 
          id="modalTrailerBtn"
          type="button"
          class="hidden py-2.5 px-4 rounded-2xl bg-slate-900 border border-slate-700 hover:border-cyan-400/80 text-white font-bold text-xs items-center justify-center gap-1.5 active:scale-95 transition-all cursor-pointer min-h-[44px]"
        >
          <svg class="w-3.5 h-3.5 text-red-500 fill-current" viewBox="0 0 24 24">
            <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
          </svg>
          <span>Trailer</span>
        </button>
      </div>

    </div>
  </div>
</div>

<script>
  let activeModalItem: any = null;

  function stopTrailer() {
    const container = document.getElementById('trailerContainer');
    const iframe = document.getElementById('trailerIframe') as HTMLIFrameElement;
    if (container && iframe) {
      container.classList.add('hidden');
      iframe.src = '';
    }
  }

  window.openItemModal = function(item: any) {
    activeModalItem = item;
    const modal = document.getElementById('itemDetailModal');
    const card = document.getElementById('itemDetailCard');
    
    if (!modal || !card) return;

    // Atualiza campos
    const backdrop = document.getElementById('modalBackdrop') as HTMLImageElement;
    const poster = document.getElementById('modalPoster') as HTMLImageElement;
    const title = document.getElementById('modalTitle');
    const rating = document.getElementById('modalRating')?.querySelector('span');
    const year = document.getElementById('modalYear');
    const duration = document.getElementById('modalDuration');
    const category = document.getElementById('modalCategory');
    const overview = document.getElementById('modalOverview');
    const genres = document.getElementById('modalGenres');
    const trailerBtn = document.getElementById('modalTrailerBtn');

    stopTrailer();

    if (backdrop) backdrop.src = item.backdrop || item.poster || '';
    if (poster) poster.src = item.poster || '';
    if (title) title.textContent = item.title || '';
    if (rating) rating.textContent = item.rating || '9.0';
    if (year) year.textContent = item.year || '2026';
    if (duration) duration.textContent = item.duration || (item.type === 'series' ? 'Série' : '4K');
    if (category) category.textContent = item.category || 'Catálogo 4K';
    if (overview) overview.textContent = item.overview || 'Sinopse disponível no aplicativo Cine 4K.';

    if (genres) {
      genres.innerHTML = '';
      if (item.genres && Array.isArray(item.genres)) {
        item.genres.forEach((g: string) => {
          const span = document.createElement('span');
          span.className = 'px-1.5 py-0.2 rounded-md bg-slate-800/90 text-slate-300 text-[10px] font-medium border border-slate-700/60';
          span.textContent = g;
          genres.appendChild(span);
        });
      }
    }

    if (trailerBtn) {
      if (item.trailerYoutubeId) {
        trailerBtn.classList.remove('hidden');
        trailerBtn.classList.add('flex');
        trailerBtn.onclick = () => {
          const container = document.getElementById('trailerContainer');
          const iframe = document.getElementById('trailerIframe') as HTMLIFrameElement;
          if (container && iframe) {
            container.classList.remove('hidden');
            iframe.src = `https://www.youtube.com/embed/${item.trailerYoutubeId}?autoplay=1`;
          }
        };
      } else {
        trailerBtn.classList.add('hidden');
        trailerBtn.classList.remove('flex');
      }
    }

    // Abre o Modal
    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100', 'pointer-events-auto');
    card.classList.remove('scale-95');
    card.classList.add('scale-100');
    document.body.style.overflow = 'hidden';
  };

  window.closeItemModal = function() {
    const modal = document.getElementById('itemDetailModal');
    const card = document.getElementById('itemDetailCard');
    if (!modal || !card) return;

    stopTrailer();
    modal.classList.remove('opacity-100', 'pointer-events-auto');
    modal.classList.add('opacity-0', 'pointer-events-none');
    card.classList.remove('scale-100');
    card.classList.add('scale-95');
    document.body.style.overflow = '';
  };

  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('itemDetailModal');
    const closeBtn = document.getElementById('closeDetailModalBtn');
    const playBtn = document.getElementById('modalPlayBtn');

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          window.closeItemModal();
        }
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        window.closeItemModal();
      });
    }

    if (playBtn) {
      playBtn.addEventListener('click', () => {
        const itemToPlay = activeModalItem;
        window.closeItemModal();
        if (window.showSubscriptionModal) {
          window.showSubscriptionModal(itemToPlay);
        }
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        window.closeItemModal();
      }
    });
  });
</script>
