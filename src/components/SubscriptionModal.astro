---
// src/components/SubscriptionModal.astro
import { SITE_CONFIG } from '../config/site';
---

<div 
  id="subscriptionModal" 
  class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-black/85 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300"
  aria-hidden="true"
  role="dialog"
>
  <div 
    id="subscriptionCard"
    class="relative w-full max-w-md bg-[#080d1a] border border-cyan-500/40 rounded-3xl shadow-2xl overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col text-slate-100"
    onclick="event.stopPropagation()"
  >
    <!-- Header com Imagem de Capa do Título Selecionado -->
    <div class="relative w-full h-44 sm:h-48 bg-slate-900 overflow-hidden flex-shrink-0">
      <img 
        id="subModalImage" 
        src="" 
        alt=""
        class="w-full h-full object-cover object-center filter brightness-[0.7]"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#080d1a] via-[#080d1a]/50 to-transparent"></div>

      <!-- Botão Fechar -->
      <button 
        id="closeSubModalBtn"
        type="button"
        aria-label="Fechar janela"
        class="absolute top-3.5 right-3.5 z-20 w-8 h-8 rounded-full bg-black/60 border border-white/20 text-white flex items-center justify-center hover:bg-cyan-500 hover:text-black transition-all cursor-pointer backdrop-blur-sm"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M6 18L18 6M6 6l12 12" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <!-- Badge Superior -->
      <div class="absolute top-3.5 left-3.5 z-10 flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-500 text-slate-950 text-[11px] font-black uppercase tracking-wider shadow">
        <span>ACESSO RESTRITO VIP</span>
      </div>

      <!-- Título Selecionado no Topo -->
      <div class="absolute bottom-3 left-4 right-4 z-10">
        <h3 id="subModalTitle" class="text-base sm:text-lg font-black text-white leading-tight drop-shadow line-clamp-1">
          Título Selecionado
        </h3>
      </div>
    </div>

    <!-- Corpo da Conversão -->
    <div class="p-5 sm:p-6 text-center flex flex-col items-center">
      
      <!-- Ícone Play Cyan Glow -->
      <div class="w-14 h-14 rounded-2xl bg-cyan-500/10 border border-cyan-400/40 flex items-center justify-center text-cyan-400 mb-3 shadow-lg shadow-cyan-500/10">
        <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
          <polygon points="5 3 19 12 5 21 5 3" />
        </svg>
      </div>

      <h4 class="text-lg sm:text-xl font-black text-white tracking-tight">
        Para assistir este conteúdo completo
      </h4>
      <p class="text-xs sm:text-sm text-slate-300 mt-1.5 max-w-xs leading-relaxed">
        Liberamos seu teste grátis ou assinatura ativa em <strong>menos de 2 minutos</strong> pelo WhatsApp para você curtir na sua Smart TV, TV Box ou celular!
      </p>

      <!-- Botões de Conversão Imediata -->
      <div class="w-full flex flex-col gap-2.5 mt-5">
        <!-- Botão WhatsApp Primário (Glow pulsante) -->
        <a 
          id="subWhatsappLink"
          href={`https://wa.me/${SITE_CONFIG.whatsapp.number}?text=${encodeURIComponent('Olá! Vim pelo catálogo Cine 4K e quero liberar meu acesso para assistir agora!')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full py-3.5 px-5 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-white font-extrabold text-sm tracking-wide shadow-lg shadow-emerald-500/25 flex items-center justify-center gap-2.5 active:scale-95 transition-all group"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>LIBERAR ACESSO NO WHATSAPP</span>
        </a>

        <!-- Botão Planos Secundário -->
        <button 
          id="subViewPlansBtn"
          type="button"
          class="w-full py-3 px-4 rounded-xl bg-slate-900 border border-slate-700/80 hover:border-cyan-500/50 text-slate-300 hover:text-white font-semibold text-xs transition-colors cursor-pointer"
        >
          Ver Tabela de Planos (A partir de R$ 30)
        </button>
      </div>

      <!-- Garantia / Segurança -->
      <div class="flex items-center justify-center gap-3 mt-4 text-[11px] text-slate-400">
        <span class="flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          Ativação Instantânea
        </span>
        <span>•</span>
        <span>Sem Fidelidade</span>
        <span>•</span>
        <span>Suporte 24h</span>
      </div>

    </div>
  </div>
</div>

<script define:vars={{ whatsappNumber: SITE_CONFIG.whatsapp.number }}>
  window.showSubscriptionModal = function(item) {
    const modal = document.getElementById('subscriptionModal');
    const card = document.getElementById('subscriptionCard');
    const img = document.getElementById('subModalImage');
    const title = document.getElementById('subModalTitle');
    const waLink = document.getElementById('subWhatsappLink');

    if (!modal || !card) return;

    if (item) {
      if (img) img.src = item.poster || item.backdrop || '/images/logo-512.png';
      if (title) title.textContent = item.title || 'Conteúdo Cine 4K';
      if (waLink) {
        const text = `Olá! Vim pelo catálogo Cine 4K e quero liberar meu acesso para assistir: ${item.title}!`;
        waLink.href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`;
      }
    }

    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100', 'pointer-events-auto');
    card.classList.remove('scale-95');
    card.classList.add('scale-100');
    document.body.style.overflow = 'hidden';
  };

  window.closeSubscriptionModal = function() {
    const modal = document.getElementById('subscriptionModal');
    const card = document.getElementById('subscriptionCard');
    if (!modal || !card) return;

    modal.classList.remove('opacity-100', 'pointer-events-auto');
    modal.classList.add('opacity-0', 'pointer-events-none');
    card.classList.remove('scale-100');
    card.classList.add('scale-95');
    document.body.style.overflow = '';
  };

  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('subscriptionModal');
    const closeBtn = document.getElementById('closeSubModalBtn');
    const plansBtn = document.getElementById('subViewPlansBtn');

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          window.closeSubscriptionModal();
        }
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        window.closeSubscriptionModal();
      });
    }

    if (plansBtn) {
      plansBtn.addEventListener('click', () => {
        window.closeSubscriptionModal();
        const planos = document.getElementById('planos');
        if (planos) {
          planos.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }
  });
</script>

