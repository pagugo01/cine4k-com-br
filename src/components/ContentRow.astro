---
// src/components/ContentRow.astro
import type { CatalogCategory } from '../data/catalog';

export interface Props {
  category: CatalogCategory;
}

const { category } = Astro.props;
---

<section class="py-3 sm:py-5" id={category.id}>
  <div class="max-w-7xl mx-auto px-2.5 sm:px-6">
    
    <!-- Cabeçalho da Linha (Conforme screenshot Virtua) -->
    <div class="flex items-center justify-between gap-2 mb-2 sm:mb-4 px-0.5">
      <h2 class="text-base sm:text-xl md:text-2xl font-black text-white tracking-tight flex items-center gap-1.5">
        <span>{category.name}</span>
      </h2>
      
      <!-- Badge de Quantidade de Itens (ex: 401 itens >) -->
      <a 
        href="#planos"
        class="inline-flex items-center gap-1 px-2.5 py-0.5 sm:px-3 sm:py-1 text-[11px] sm:text-xs font-semibold rounded-full bg-cyan-950/50 text-cyan-400 border border-cyan-800/50 hover:bg-cyan-900/50 hover:border-cyan-500/80 transition-colors flex-shrink-0"
      >
        <span>{category.badge}</span>
      </a>
    </div>

    <!-- Carrossel Horizontal com Rolagem Suave -->
    <div class="relative group/row">
      
      <!-- Botão Scroll Esquerda (Desktop) -->
      <button 
        type="button"
        aria-label="Rolar para esquerda"
        data-row-prev={category.id}
        class="hidden md:flex absolute -left-3 top-1/2 -translate-y-1/2 z-20 w-9 h-9 rounded-full bg-slate-900/90 border border-slate-700/80 text-white items-center justify-center opacity-0 group-hover/row:opacity-100 transition-opacity hover:bg-cyan-500 hover:text-black cursor-pointer shadow-xl backdrop-blur-sm"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M15 19l-7-7 7-7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <!-- Container dos Cards (Exatamente 3 cards + 1 peek no celular) -->
      <div 
        id={`row-${category.id}`}
        class="flex gap-2.5 sm:gap-4 overflow-x-auto no-scrollbar scroll-smooth snap-x snap-mandatory py-1.5 -mx-2.5 px-2.5 sm:mx-0 sm:px-0"
      >
        {category.items.map((item) => (
          <div 
            class="flex-shrink-0 w-[105px] xs:w-[115px] sm:w-[160px] md:w-[185px] snap-start group/card cursor-pointer"
            data-catalog-item={JSON.stringify(item)}
            data-item-title={item.title}
          >
            <div class="relative aspect-[2/3] w-full rounded-xl sm:rounded-2xl overflow-hidden bg-slate-900 border border-slate-800/90 group-hover/card:border-cyan-400/80 transition-all duration-300 shadow-md group-hover/card:shadow-cyan-500/20 group-hover/card:-translate-y-1">
              
              <!-- Imagem da Capa TMDb -->
              <img 
                src={item.poster} 
                alt={item.title}
                class="w-full h-full object-cover object-center group-hover/card:scale-105 transition-transform duration-300"
                loading="lazy"
                onerror="this.onerror=null; this.src='/images/logo-512.png';"
              />

              <!-- Overlay Gradiente Escuro no Rodapé (Idêntico ao app Virtua) -->
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent opacity-95 group-hover/card:opacity-100 transition-opacity"></div>

              <!-- Rating Badge no Topo Direito -->
              <div class="absolute top-1.5 right-1.5 sm:top-2 sm:right-2 px-1 py-0.2 sm:px-1.5 sm:py-0.5 rounded-md bg-black/75 backdrop-blur-sm border border-white/10 text-[9px] sm:text-[10px] font-bold text-amber-400 flex items-center gap-0.5">
                <span>★</span>
                <span>{item.rating}</span>
              </div>

              <!-- Tipo no Topo Esquerdo -->
              <div class="absolute top-1.5 left-1.5 sm:top-2 sm:left-2 px-1 py-0.2 sm:px-1.5 sm:py-0.5 rounded-md bg-cyan-500/90 text-slate-950 text-[8px] sm:text-[9px] font-black uppercase tracking-wider">
                {item.type === 'football' ? 'AO VIVO' : item.type === 'series' ? 'SÉRIE' : '4K'}
              </div>

              <!-- Título e Gênero no Rodapé do Card -->
              <div class="absolute bottom-0 inset-x-0 p-2 sm:p-3 flex flex-col justify-end">
                <h3 class="text-[11px] sm:text-sm font-bold text-white line-clamp-2 leading-tight group-hover/card:text-cyan-300 transition-colors drop-shadow">
                  {item.title}
                </h3>
                <span class="text-[9px] sm:text-[10px] text-slate-400 font-medium mt-0.5 line-clamp-1">
                  {item.year} • 4K
                </span>
              </div>

            </div>
          </div>
        ))}
      </div>

      <!-- Botão Scroll Direita (Desktop) -->
      <button 
        type="button"
        aria-label="Rolar para direita"
        data-row-next={category.id}
        class="hidden md:flex absolute -right-3 top-1/2 -translate-y-1/2 z-20 w-9 h-9 rounded-full bg-slate-900/90 border border-slate-700/80 text-white items-center justify-center opacity-0 group-hover/row:opacity-100 transition-opacity hover:bg-cyan-500 hover:text-black cursor-pointer shadow-xl backdrop-blur-sm"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M9 5l7 7-7 7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

    </div>

  </div>
</section>

<script define:vars={{ rowId: category.id }}>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById(`row-${rowId}`);
    const prevBtn = document.querySelector(`[data-row-prev="${rowId}"]`);
    const nextBtn = document.querySelector(`[data-row-next="${rowId}"]`);

    if (prevBtn && container) {
      prevBtn.addEventListener('click', () => {
        container.scrollBy({ left: -300, behavior: 'smooth' });
      });
    }

    if (nextBtn && container) {
      nextBtn.addEventListener('click', () => {
        container.scrollBy({ left: 300, behavior: 'smooth' });
      });
    }

    function bindCardClick(card) {
      card.addEventListener('click', () => {
        try {
          const item = JSON.parse(card.getAttribute('data-catalog-item') || '{}');
          if (window.openItemModal) {
            window.openItemModal(item);
          }
        } catch (e) {
          console.error('Erro ao ler item:', e);
        }
      });
    }

    // Clique inicial nos cards estáticos
    if (container) {
      const cards = container.querySelectorAll('[data-catalog-item]');
      cards.forEach(bindCardClick);

      // Auto-Sync Dinâmico com TMDb Oficial via API própria (apenas categorias de filmes/séries)
      if (['lancamentos', 'acao', 'animacao', 'anime', 'series'].includes(rowId)) {
        fetch(`/api/tmdb.php?cat=${rowId}`)
          .then(res => res.json())
          .then(data => {
            if (data.success && Array.isArray(data.items) && data.items.length > 0) {
              const existingTitles = new Set(
                Array.from(container.querySelectorAll('[data-item-title]'))
                  .map(el => el.getAttribute('data-item-title')?.toLowerCase().trim())
              );

              // Insere novos filmes da TMDb
              data.items.forEach(newItem => {
                if (!existingTitles.has(newItem.title.toLowerCase().trim())) {
                  const cardDiv = document.createElement('div');
                  cardDiv.className = 'flex-shrink-0 w-[105px] xs:w-[115px] sm:w-[160px] md:w-[185px] snap-start group/card cursor-pointer';
                  cardDiv.setAttribute('data-catalog-item', JSON.stringify(newItem));
                  cardDiv.setAttribute('data-item-title', newItem.title);
                  cardDiv.innerHTML = `
                    <div class="relative aspect-[2/3] w-full rounded-xl sm:rounded-2xl overflow-hidden bg-slate-900 border border-slate-800/90 group-hover/card:border-cyan-400/80 transition-all duration-300 shadow-md group-hover/card:shadow-cyan-500/20 group-hover/card:-translate-y-1">
                      <img src="${newItem.poster}" alt="${newItem.title}" class="w-full h-full object-cover object-center group-hover/card:scale-105 transition-transform duration-300" loading="lazy" onerror="this.onerror=null; this.src='/images/logo-512.png';" />
                      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent opacity-95 group-hover/card:opacity-100 transition-opacity"></div>
                      <div class="absolute top-1.5 right-1.5 sm:top-2 sm:right-2 px-1 py-0.2 sm:px-1.5 sm:py-0.5 rounded-md bg-black/75 backdrop-blur-sm border border-white/10 text-[9px] sm:text-[10px] font-bold text-amber-400 flex items-center gap-0.5">
                        <span>★</span><span>${newItem.rating}</span>
                      </div>
                      <div class="absolute top-1.5 left-1.5 sm:top-2 sm:left-2 px-1 py-0.2 sm:px-1.5 sm:py-0.5 rounded-md bg-cyan-500/90 text-slate-950 text-[8px] sm:text-[9px] font-black uppercase tracking-wider">
                        ${newItem.type === 'series' ? 'SÉRIE' : '4K'}
                      </div>
                      <div class="absolute bottom-0 inset-x-0 p-2 sm:p-3 flex flex-col justify-end">
                        <h3 class="text-[11px] sm:text-sm font-bold text-white line-clamp-2 leading-tight group-hover/card:text-cyan-300 transition-colors drop-shadow">
                          ${newItem.title}
                        </h3>
                        <span class="text-[9px] sm:text-[10px] text-slate-400 font-medium mt-0.5 line-clamp-1">
                          ${newItem.year} • 4K
                        </span>
                      </div>
                    </div>
                  `;
                  bindCardClick(cardDiv);
                  container.prepend(cardDiv);
                }
              });
            }
          })
          .catch(() => {});
      }
    }
  });
</script>
