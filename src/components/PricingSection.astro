---
// src/components/PricingSection.astro
import { PRICING_PLANS } from '../config/pricing';
import { SITE_CONFIG } from '../config/site';
---

<section id="planos" class="py-16 sm:py-24 bg-[#040711] relative overflow-hidden">
  <!-- Efeitos de Luz de Fundo -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
    
    <!-- Cabeçalho da Seção de Planos -->
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/80 border border-cyan-500/40 text-cyan-300 text-xs font-bold uppercase tracking-wider mb-3">
        <span>Planos Sem Fidelidade</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight">
        Escolha o seu plano <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">Cine 4K</span>
      </h2>
      <p class="text-sm sm:text-base text-slate-300 mt-3 font-medium">
        Todos os planos incluem catálogo completo de lançamentos, filmes, séries e canais em 4K nativo com liberação imediata.
      </p>
    </div>

    <!-- Grid dos 4 Planos -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-5">
      {PRICING_PLANS.map((plan) => (
        <div class={`relative rounded-3xl p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 ${
          plan.popular 
            ? 'bg-gradient-to-b from-[#0c1f36] to-[#080d1a] border-2 border-cyan-400 shadow-xl shadow-cyan-500/20 scale-105 z-20' 
            : 'bg-[#080d1a] border border-slate-800 hover:border-slate-700'
        }`}>
          
          {plan.popular && (
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-gradient-to-r from-cyan-400 to-blue-500 text-slate-950 text-xs font-black uppercase tracking-wider shadow-lg">
              MAIS ESCOLHIDO 🔥
            </div>
          )}

          <div>
            <!-- Cabeçalho do Card -->
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-sm font-black text-cyan-400 uppercase tracking-wider">{plan.duration}</span>
              <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-300 font-bold border border-slate-700">
                {plan.screens} {plan.screens === 1 ? 'Tela' : 'Telas'}
              </span>
            </div>

            <p class="text-xs text-slate-400 font-medium mb-4">{plan.desc}</p>

            <!-- Preço -->
            <div class="flex items-baseline gap-1 mb-6">
              <span class="text-xs font-bold text-slate-400">R$</span>
              <span class="text-4xl sm:text-5xl font-black text-white tracking-tight">{plan.price}</span>
              <span class="text-xs font-semibold text-slate-400">,00</span>
              {plan.oldPrice && (
                <span class="text-xs text-slate-500 line-through ml-2">R$ {plan.oldPrice}</span>
              )}
            </div>

            <!-- Lista de Benefícios -->
            <ul class="flex flex-col gap-3 text-xs sm:text-sm text-slate-300 mb-8 border-t border-slate-800/80 pt-5">
              {plan.features.map((feat) => (
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-cyan-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <polyline points="20 6 9 17 4 12" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Botão CTA -->
          <div class="mt-auto pt-2">
            <a 
              href={plan.ctaRoute}
              class={`w-full py-3.5 px-4 rounded-2xl font-black text-xs sm:text-sm tracking-wide text-center flex items-center justify-center gap-2 transition-all active:scale-95 shadow-md ${
                plan.popular
                  ? 'bg-gradient-to-r from-cyan-400 to-blue-500 hover:from-cyan-300 hover:to-blue-400 text-slate-950 shadow-cyan-500/30'
                  : 'bg-slate-800 hover:bg-slate-700 text-white border border-slate-700 hover:border-cyan-500/50'
              }`}
            >
              <span>{plan.ctaText}</span>
            </a>
          </div>

        </div>
      ))}
    </div>

    <!-- Garantia e Formas de Pagamento -->
    <div class="mt-12 text-center text-xs text-slate-400 flex flex-wrap items-center justify-center gap-4 sm:gap-8">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
        Pagamento Seguro via Pix ou Cartão
      </span>
      <span>•</span>
      <span>Liberação em 2 Minutos</span>
      <span>•</span>
      <span>Cancelamento Grátis a qualquer momento</span>
    </div>

  </div>
</section>
