---
// src/pages/ir/[dest].astro
import { PRICING_PLANS } from '../../config/pricing';
import { SITE_CONFIG } from '../../config/site';

export function getStaticPaths() {
  const paths = [
    {
      params: { dest: 'teste-gratis' },
      props: {
        targetUrl: `https://wa.me/${SITE_CONFIG.whatsapp.number}?text=${encodeURIComponent('Olá! Vim pelo site Cine 4K e quero solicitar meu Teste Grátis!')}`,
        title: 'Redirecionando para Teste Grátis no WhatsApp...'
      }
    },
    {
      params: { dest: 'whatsapp' },
      props: {
        targetUrl: `https://wa.me/${SITE_CONFIG.whatsapp.number}?text=${encodeURIComponent(SITE_CONFIG.whatsapp.defaultMessage)}`,
        title: 'Redirecionando para o WhatsApp Oficial...'
      }
    },
    {
      params: { dest: 'revenda' },
      props: {
        targetUrl: `https://wa.me/${SITE_CONFIG.whatsapp.number}?text=${encodeURIComponent('Olá! Gostaria de saber mais sobre a revenda de painel no Cine 4K!')}`,
        title: 'Redirecionando para Painel de Revenda...'
      }
    }
  ];

  PRICING_PLANS.forEach(plan => {
    paths.push({
      params: { dest: `plano-${plan.id}` },
      props: {
        targetUrl: `https://wa.me/${SITE_CONFIG.whatsapp.number}?text=${encodeURIComponent(plan.whatsappMessage)}`,
        title: `Redirecionando para contratação do Plano ${plan.duration}...`
      }
    });
  });

  return paths;
}

const { targetUrl, title } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <link rel="canonical" href={targetUrl} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        background: #040711;
        color: #f8fafc;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-family: system-ui, -apple-system, sans-serif;
        text-align: center;
        padding: 20px;
      }
      .spinner {
        width: 48px;
        height: 48px;
        border: 4px solid #0e1e38;
        border-top-color: #06b6d4;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin-bottom: 20px;
      }
      @keyframes spin {
        to { transform: rotate(360deg); }
      }
      a {
        color: #22d3ee;
        text-decoration: underline;
        margin-top: 15px;
        display: inline-block;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <div class="spinner"></div>
    <h1 style="font-size: 1.25rem; font-weight: 800; margin: 0 0 10px 0;">Redirecionando para o WhatsApp Oficial...</h1>
    <p style="font-size: 0.875rem; color: #94a3b8; margin: 0;">Você será atendido em instantes pela nossa equipe.</p>
    <a href={targetUrl}>Clique aqui se não for redirecionado automaticamente</a>
    <script define:vars={{ targetUrl }}>
      window.location.href = targetUrl;
    </script>
  </body>
</html>
