---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroFeatured from '../components/HeroFeatured.astro';
import ContentRow from '../components/ContentRow.astro';
import PricingSection from '../components/PricingSection.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
import FloatingPills from '../components/FloatingPills.astro';
import MobileBottomDock from '../components/MobileBottomDock.astro';
import ItemDetailModal from '../components/ItemDetailModal.astro';
import SubscriptionModal from '../components/SubscriptionModal.astro';
import SearchModal from '../components/SearchModal.astro';
import { CATALOG_CATEGORIES } from '../data/catalog';
import { SITE_CONFIG } from '../config/site';
---

<Layout 
  title={`${SITE_CONFIG.name} — ${SITE_CONFIG.tagline}`}
  description={SITE_CONFIG.description}
>
  <!-- Barra de Topo / Header -->
  <Header />

  <!-- Destaque Principal Cinemático (Hero) -->
  <main class="pt-[52px] sm:pt-[64px]">
    <HeroFeatured />

    <!-- Fileiras do Catálogo Estilo Netflix / Virtua -->
    <div id="catalogo" class="flex flex-col gap-2 sm:gap-4 pb-12">
      {CATALOG_CATEGORIES.map((category) => (
        <ContentRow category={category} />
      ))}
    </div>

    <!-- Tabela de Planos Oficiais -->
    <PricingSection />

    <!-- Dúvidas Frequentes -->
    <FaqSection />
  </main>

  <!-- Rodapé -->
  <Footer />

  <!-- Pílulas Flutuantes (Canal WhatsApp & Suporte) -->
  <FloatingPills />

  <!-- Barra de Navegação Inferior Mobile (Início, Filmes, Séries, Canais, Futebol) -->
  <MobileBottomDock />

  <!-- Modais Interativos de Detalhes, Assinatura e Busca -->
  <ItemDetailModal />
  <SubscriptionModal />
  <SearchModal />
</Layout>

